# --- Server-side only (read by the Vite dev/preview proxy; never bundled) ---

# OpenRouter key: used to write image prompts and for the Gemini image model.
OPENROUTER_API_KEY=

# Hugging Face access token: used for Stable Diffusion XL.
HUGGINGFACE_API_KEY=
# HUGGINGFACE_BASE_URL=https://router.huggingface.co/hf-inference

# --- Public build-time settings (bundled into the client) ---

# Institution name shown on posts and used in prompts.
VITE_BRAND_NAME=ICAS Manipal

# Base path of the AI proxy (change if your production proxy uses another path).
# VITE_AI_PROXY_BASE=/api

# OpenRouter model used to write image prompts.
# VITE_PROMPT_MODEL=anthropic/claude-3.5-sonnet
