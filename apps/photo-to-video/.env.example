# Port for the Express API (and the built frontend in production).
PORT=3001

# Where uploads, rendered videos and generated audio are stored.
# Defaults to the server/ directory.
# DATA_DIR=/var/lib/photo-to-video

# Comma-separated origins allowed to call the API cross-origin.
# Not needed in development (Vite proxies /api) or when the server serves the frontend.
# CORS_ORIGIN=https://example.com

# Optional: AI narration script generation via OpenRouter.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Optional: text-to-speech narration via ElevenLabs.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
