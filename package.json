{
  "name": "administration",
  "private": true,
  "description": "Internal marketing and media tools: an AI social-post generator and a photo-to-video slideshow maker.",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev:marketing": "npm run dev -w marketing-tool",
    "dev:video": "npm run dev -w photo-to-video",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
